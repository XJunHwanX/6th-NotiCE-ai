# 이 파일을 `.env.local` 로 복사한 뒤 실제 값을 채우세요.
#   cp .env.local.example .env.local
# `.env.local` 은 .gitignore 되어 커밋되지 않습니다.

# ── Supabase ────────────────────────────────────────────────
# Supabase 대시보드 → Project Settings → API 에서 복사.
# 값이 비어 있으면 앱은 더미 데이터로 동작합니다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Web Push (VAPID) ────────────────────────────────────────
# 브라우저 pushManager.subscribe() 의 applicationServerKey 로 쓰이는
# "공개키"입니다. base64url raw 형식(약 87자, 'B' 로 시작)이어야 합니다.
#
# 키 쌍 생성:      npx web-push generate-vapid-keys
#   → 출력된 Public Key 를 그대로 여기에 넣으면 됩니다.
#   → Private Key 는 발송 서버(백엔드)에만 두고 절대 커밋하지 마세요.
#
# PEM(-----BEGIN PUBLIC KEY-----) 형식만 있다면 raw base64url 로 변환 필요:
#   node -e "const c=require('crypto'),j=c.createPublicKey(require('fs').readFileSync('vapid.pem','utf8')).export({format:'jwk'});console.log(Buffer.concat([Buffer.from([4]),Buffer.from(j.x,'base64url'),Buffer.from(j.y,'base64url')]).toString('base64url'))"
#
# 값이 비어 있으면 푸시 구독 기능은 조용히 비활성화됩니다.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
